__pycache__/
*.pyc
node_modules/
data/raw/

# results/ mixes cited evidence with regenerable bulk, so it is listed
# explicitly instead of being ignored wholesale. README.md and HANDOFF.md cite
# results/illumination/ILLUMINATION.md as "the committed figures", and
# results/experiments/P0_FINDINGS.md is now cited the same way; a blanket
# results/*/ rule made both of those claims false.

# ~209 MB of LRO NAC mosaic crops, one file over GitHub's 100 MB limit.
# scripts/exp_reference.py re-fetches any region on demand, so this is a
# cache, not evidence.
results/nac_cache/

# resolved PDS redirect, re-derived on first use
.nac_url

# LROC full-resolution range-read cache (scripts/fetch_lroc_pairs.py)
results/lroc_cache/

# Phase 1 data layer. Heavy, regenerable, and provenance lives in
# data/manifest.jsonl which IS tracked.
data/index/
data/processed/

# Training checkpoints: 138 MB each, regenerable, and the shipping path does not
# need one. history.json is small but lives alongside them, so the whole
# directory is ignored and the curve is quoted in docs/TRAINING.md instead.
results/train/
results/illumination_bench/raw.json

# Ephemeral outputs from registration tool runs and tests
outputs/
